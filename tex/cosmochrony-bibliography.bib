  title = {{Projection as Conditional Expectation and the Capacity Ceiling}},
  journal = {Working paper},
  year = {2026},
  note = {Derives the amplitude-level action of the non-injective projection as the conditional expectation onto the distinguishable-record sigma-algebra, under four graded hypotheses and by two independent classical characterisations (contractive projections; Moy--Rota--Douglas averaging operators); converts it into strict ensemble-power suppression (law of total variance) and the parameter-free capacity ceiling $(N-1)/N$ for a complex Gaussian mode on $N$ distinguishable histories --- identically the Bessel envelope of the low-$\ell$ capacity note.
 \doi{10.5281/zenodo.21227547}}
}

